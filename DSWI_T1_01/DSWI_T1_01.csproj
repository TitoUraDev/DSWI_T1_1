<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Si tu SDK es el 10: cambia a net10.0 y EfVersion a 10.0.* -->
    <TargetFramework>net8.0</TargetFramework>
    <EfVersion>8.0.*</EfVersion>
    <!-- Corre tambien sobre runtimes mayores (9, 10...) si no hay exactamente el 8 -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EfVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
