@model EnvioViewModel
@{
    ViewData["Title"] = "Envíos";
}
<h2>Costo de envío de paquetes</h2>

<form asp-action="Index" method="post" class="row g-3 my-3">
    <div class="col-md-4">
        <label asp-for="Peso" class="form-label"></label>
        <input asp-for="Peso" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Peso" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label">@Html.DisplayNameFor(m => m.EsInternacional)</label>
        <div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="EsInternacional" id="intSi" value="true" @(Model.EsInternacional ? "checked" : "") />
                <label class="form-check-label" for="intSi">Sí</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="EsInternacional" id="intNo" value="false" @(!Model.EsInternacional ? "checked" : "") />
                <label class="form-check-label" for="intNo">No</label>
            </div>
        </div>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Calcular</button>
    </div>
</form>

@if (Model.Resultado is { } r)
{
    <div class="card card-resultado">
        <div class="card-body">
            <p class="mb-1"><strong>Peso:</strong> @r.Peso.ToString("N2") kg</p>
            <p class="mb-1"><strong>Costo por kilo:</strong> $ @r.TarifaPorKilo.ToString("N2")</p>
            <p class="mb-1"><strong>Recargo internacional:</strong> $ @r.Recargo.ToString("N2")</p>
            <p class="mb-0 fs-5"><strong>Total a pagar:</strong> $ @r.Total.ToString("N2")</p>
        </div>
    </div>
}
