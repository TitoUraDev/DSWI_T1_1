@model IEnumerable<Paciente>
@{
    ViewData["Title"] = "Pacientes";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Pacientes</h2>
    <a class="btn btn-success" asp-action="Create">Nuevo paciente</a>
</div>
<table class="table table-striped bg-white">
    <thead class="table-dark">
        <tr><th>ID</th><th>Nombre</th><th>DNI</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.PacienteId</td>
            <td>@p.Nombre</td>
            <td>@p.Dni</td>
            <td>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.PacienteId">Editar</a>
                <form asp-action="Eliminar" asp-route-id="@p.PacienteId" method="post" class="d-inline"
                      onsubmit="return confirm('¿Eliminar a @p.Nombre y todas sus citas?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
