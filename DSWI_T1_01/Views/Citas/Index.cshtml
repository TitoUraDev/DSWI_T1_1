@model IEnumerable<CitaListadoViewModel>
@{
    ViewData["Title"] = "Citas";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Citas</h2>
    <a class="btn btn-success" asp-action="Create">Nueva cita</a>
</div>
<table class="table table-striped bg-white">
    <thead class="table-dark">
        <tr><th>ID</th><th>Fecha</th><th>Hora</th><th>Especialidad</th><th>Estado</th><th>Paciente</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.CitaId</td>
            <td>@c.Fecha?.ToString("dd/MM/yyyy")</td>
            <td>@c.Hora?.ToString("HH:mm")</td>
            <td>@c.Especialidad</td>
            <td>@c.Estado</td>
            <td>@c.PacienteNombre</td>
            <td>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.CitaId">Editar</a>
                <form asp-action="Eliminar" asp-route-id="@c.CitaId" method="post" class="d-inline"
                      onsubmit="return confirm('¿Eliminar la cita @c.CitaId?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
