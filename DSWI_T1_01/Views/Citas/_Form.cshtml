@model CitaFormViewModel
<input type="hidden" asp-for="CitaId" />
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Fecha" class="form-label"></label>
        <input asp-for="Fecha" type="date" class="form-control" />
        <span asp-validation-for="Fecha" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Hora" class="form-label"></label>
        <input asp-for="Hora" type="time" class="form-control" />
        <span asp-validation-for="Hora" class="text-danger"></span>
    </div>
</div>
<div class="mb-3">
    <label asp-for="Especialidad" class="form-label"></label>
    <input asp-for="Especialidad" class="form-control" />
    <span asp-validation-for="Especialidad" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Estado" class="form-label"></label>
    <select asp-for="Estado" asp-items="Model.Estados" class="form-select">
        <option value="">-- Seleccione --</option>
    </select>
    <span asp-validation-for="Estado" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="PacienteId" class="form-label"></label>
    <select asp-for="PacienteId" asp-items="Model.Pacientes" class="form-select">
        <option value="">-- Seleccione --</option>
    </select>
    <span asp-validation-for="PacienteId" class="text-danger"></span>
</div>
<button type="submit" class="btn btn-primary">Guardar</button>
<a class="btn btn-secondary" asp-action="Index">Cancelar</a>
