<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DSWI_T1_01</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">DSWI_T1_01</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Prestamo" asp-action="Index">Préstamos</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Envio" asp-action="Index">Envíos</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Pacientes" asp-action="Index">Pacientes</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Citas" asp-action="Index">Citas</a></li>
            </ul>
        </div>
    </nav>
    <main class="container py-4">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success">@mensaje</div>
        }
        @RenderBody()
    </main>
</body>
</html>
