@model CitaDto
@{ViewData["Title"]="Editar cita";}<h1>Editar cita</h1><form asp-action="Edit" method="post" class="form-card"><input asp-for="CitaID" type="hidden"/><label asp-for="Fecha"></label><input asp-for="Fecha" type="date" class="form-control mb-2"/><label asp-for="Hora"></label><input asp-for="Hora" type="time" class="form-control mb-2"/><label asp-for="Especialidad"></label><input asp-for="Especialidad" class="form-control mb-2"/><label asp-for="Estado"></label><select asp-for="Estado" class="form-select mb-2"><option>Pendiente</option><option>Confirmada</option><option>Cancelada</option></select><label asp-for="PacienteID">Paciente</label><select asp-for="PacienteID" asp-items="ViewBag.Pacientes" class="form-select mb-3"></select><div asp-validation-summary="All" class="text-danger"></div><button class="btn btn-primary">Actualizar</button> <a asp-action="Index">Volver</a></form>