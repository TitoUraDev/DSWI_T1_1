@model CalculadoraVm
@{ViewData["Title"]="Calculadora";}<h1>Pregunta 01 - Cálculos</h1><div class="row g-4"><div class="col-md-6"><div class="card p-3"><h4>Préstamo</h4><form asp-action="Prestamo" method="post"><label asp-for="Prestamo.Monto"></label><input asp-for="Prestamo.Monto" type="number" min="0.01" step="0.01" class="form-control"/><span asp-validation-for="Prestamo.Monto" class="text-danger"></span><button class="btn btn-primary mt-3">Calcular</button></form>@if(Model.Prestamo.Total.HasValue){<hr/><p>Cuotas: <b>@Model.Prestamo.Cuotas</b></p><p>Interés: $@Model.Prestamo.Interes?.ToString("N2") (@(Model.Prestamo.Tasa*100)%)</p><p>Total: <b>$@Model.Prestamo.Total?.ToString("N2")</b></p><p>Valor por cuota: <b>$@Model.Prestamo.Cuota?.ToString("N2")</b></p>}</div></div><div class="col-md-6"><div class="card p-3"><h4>Envío</h4><form asp-action="Envio" method="post"><label asp-for="Envio.Peso"></label><input asp-for="Envio.Peso" type="number" min="0.01" step="0.01" class="form-control"/><span asp-validation-for="Envio.Peso" class="text-danger"></span><div class="form-check mt-2"><input asp-for="Envio.Internacional" class="form-check-input"/><label asp-for="Envio.Internacional" class="form-check-label">Internacional</label></div><button class="btn btn-primary mt-3">Calcular</button></form>@if(Model.Envio.Total.HasValue){<hr/><p>Tarifa por kilo: $@Model.Envio.Tarifa</p><p>Subtotal: $@Model.Envio.Subtotal?.ToString("N2")</p><p>Recargo: $@Model.Envio.Recargo</p><p>Total: <b>$@Model.Envio.Total?.ToString("N2")</b></p>}</div></div></div>